{
  "name": "dominion",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w @dominion/server\" \"npm run dev -w @dominion/web\"",
    "dev:mobile": "npm run start:dev-client -w @dominion/mobile",
    "prebuild:ios": "npm run prebuild:ios -w @dominion/mobile",
    "build": "npm run build -w @dominion/shared && npm run build -w @dominion/server && npm run build -w @dominion/web",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "test": "npm run test:unit && npm run test:build",
    "dev:check": "npm run typecheck && npm run test",
    "test:unit": "node --test ./scripts/build-doctor.test.mjs ./scripts/deploy-check.test.mjs && npm run test -w @dominion/web",
    "test:build": "node --test ./scripts/build-health.test.mjs",
    "deploy:check": "node ./scripts/deploy-check.mjs",
    "doctor": "node ./scripts/build-doctor.mjs",
    "bootstrap": "node ./scripts/build-doctor.mjs --fix"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.8.2",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  }
}
