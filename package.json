{
  "name": "neurofang",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w @neurofang/server\" \"npm run dev -w @neurofang/web\"",
    "dev:mobile": "npm run start -w @neurofang/mobile",
    "build": "npm run build -w @neurofang/shared && npm run build -w @neurofang/server && npm run build -w @neurofang/web",
    "typecheck": "npm run typecheck -ws"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.8.2"
  }
}
